<?xml version='1.0' encoding='UTF-8'?>  
<!DOCTYPE hibernate-configuration PUBLIC  
   "-//Hibernate/Hibernate Configuration DTD 3.0//EN"  
   "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">  

<hibernate-configuration>  
   <session-factory>  
      <property name="hbm2ddl.auto">update</property>  
      <property name="dialect">org.hibernate.dialect.MySQL8Dialect</property>  
      <property name="connection.url">jdbc:mysql://localhost:3306/citius_db</property>  
      <property name="connection.username">root</property>  
      <property name="connection.password">root</property>  
      <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>  
      <mapping class="com.example.Employee"/>   
      <mapping class="com.example.Worker"/>   
      <mapping class="com.example.PermanentWorker"/>   
      <mapping class="com.example.ContractEmployee"/>  
      <mapping class="com.example.Passport" />  
      <mapping class="com.example.User" />
   </session-factory>  
</hibernate-configuration>